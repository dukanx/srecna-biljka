# Lokalno: pojedinačne promenljive.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iot_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Na hostingu: jedan URL ima prednost nad gornjim promenljivim.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DB_SSLMODE=require        # podrazumevano require kad se koristi DATABASE_URL

# Zaštita upisnih ruta (POST/PUT/DELETE). Prazno znači da je provera isključena.
# Na javnom hostingu je obavezan; isti string stoji i u sketch/secrets.h.
# Generisanje: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Web Push (VAPID). Ključevi se generišu sa: python gen_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:tvoj_email@example.com
